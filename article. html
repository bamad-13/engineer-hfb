<script src="assets/js/api.js"></script>
<script src="assets/js/main.js"></script>
<script>
document.addEventListener("DOMContentLoaded", async () => {
    const el = document.getElementById("articlesList");
    const data = await apiGet("/v1/articles");
    
    if (!data || !data.articles || data.articles.length === 0) {
        el.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-icon">📭</div>
                <h3>لا توجد مقالات بعد</h3>
                <p>قريبًا ستجد هنا مقالاتي</p>
            </div>
        `;
        return;
    }
    
    el.innerHTML = data.articles.map(a => {
        const date = new Date(a.time).toLocaleDateString('ar-LY');
        return `
            <div class="article-card" onclick="location.href='article.html?id=${a.id}'">
                <h4>${a.title}</h4>
                <p>${(a.excerpt || a.content || '').substring(0, 150)}...</p>
                <div class="article-meta">📅 ${date}</div>
            </div>
        `;
    }).join("");
    
    trackVisit();
});
</script>
